<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="326.0" prefWidth="240.0" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.spicuzza.client.LoginController">
    <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../../image/icon2.png" />
         </image></ImageView>
      <TextField fx:id="user" styleClass="log_input" />
      <PasswordField fx:id="password" styleClass="log_input" />
      <HBox alignment="CENTER" maxHeight="30.0" minHeight="20.0" prefHeight="25.0" prefWidth="200.0" spacing="25.0">
         <children>
            <Button fx:id="login" mnemonicParsing="false" onAction="#login" styleClass="log_reg" text="Log In" />
            <Button fx:id="register" mnemonicParsing="false" onAction="#register" styleClass="log_reg" text="Register" />
         </children>
      </HBox>
      <Label fx:id="popolaDatabase" onMouseClicked="#popolaDatabase" text="Popola Database" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
