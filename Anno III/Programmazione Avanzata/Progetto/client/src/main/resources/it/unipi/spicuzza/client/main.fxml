<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="820.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.spicuzza.client.MainController">
    <children>
      <HBox prefHeight="37.0" prefWidth="200.0">
         <children>
            <TextField fx:id="search" prefHeight="31.0" prefWidth="514.0" />
            <ToggleButton fx:id="fos" mnemonicParsing="false" onAction="#switchProdotto" prefHeight="31.0" prefWidth="181.0" />
         </children>
      </HBox>
      <TableView fx:id="table_View">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" onAction="#removeFromWatchList" text="Rimuovi da Lista" />
                  <MenuItem mnemonicParsing="false" onAction="#removeFromWatched" text="Rimuovi da Visto" />
                  <MenuItem mnemonicParsing="false" onAction="#removeFromPreferito" text="Rimuovi da Preferito" />
              </items>
            </ContextMenu>
         </contextMenu></TableView>
      <HBox alignment="CENTER" prefHeight="72.0" prefWidth="560.0">
         <children>
            <Button fx:id="all" mnemonicParsing="false" styleClass="b_main">
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="watchList" mnemonicParsing="false" styleClass="b_main">
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="watched" mnemonicParsing="false" styleClass="b_main">
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="preferito" mnemonicParsing="false" styleClass="b_main">
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="exit" mnemonicParsing="false" onAction="#switchToLogin" styleClass="b_main">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
